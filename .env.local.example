# For `npm run dev` only. Inside the packaged app, electron/bootstrap-db.js
# generates all of this per install and passes it to the Next.js child
# process directly - none of it is read from a file there.

PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=pump
PGUSER=app_user
PGPASSWORD=changeme

# 32+ random characters. Signs the session cookie - see app/_lib/auth.js.
SESSION_SECRET=

# Shows the "empty everything" button on Settings. Leave unset in anything
# resembling production use - see fullResetAllowed() in app/_lib/helpers.js.
ALLOW_FULL_RESET=false
