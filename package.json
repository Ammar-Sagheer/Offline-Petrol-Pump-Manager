{
  "name": "offline-petrol-pump-manager",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node electron/copy-standalone-assets.js",
    "start": "next start",
    "lint": "next lint",
    "electron": "electron .",
    "electron:dev": "cross-env ELECTRON_DEV=true electron .",
    "dist": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder"
  },
  "dependencies": {
    "embedded-postgres": "^17.5.0-beta.15",
    "iron-session": "^8.0.4",
    "jszip": "^3.10.1",
    "next": "^16.0.0",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.0"
  },
  "build": {
    "appId": "com.pumpmanager.offline",
    "productName": "Pump Manager",
    "asar": false,
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      "db/migrations/**/*",
      "package.json",
      "!node_modules/**/*",
      "node_modules/pg/**/*",
      "node_modules/pg-cloudflare/**/*",
      "node_modules/pg-connection-string/**/*",
      "node_modules/pg-int8/**/*",
      "node_modules/pg-pool/**/*",
      "node_modules/pg-protocol/**/*",
      "node_modules/pg-types/**/*",
      "node_modules/pgpass/**/*",
      "node_modules/postgres-array/**/*",
      "node_modules/postgres-bytea/**/*",
      "node_modules/postgres-date/**/*",
      "node_modules/postgres-interval/**/*",
      "node_modules/split2/**/*",
      "node_modules/xtend/**/*",
      "node_modules/async-exit-hook/**/*",
      "node_modules/embedded-postgres/**/*",
      "node_modules/@embedded-postgres/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "signAndEditExecutable": false
    }
  }
}
